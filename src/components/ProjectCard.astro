---
// One project on the Research page. Main projects get a large square
// thumbnail; sub-projects (those with `parent:` set) get a smaller one.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { href } from '../lib/url';

interface Paper {
  title: string;
  link?: string;
  venue?: string;
  status?: string;
  date: Date;
}

interface Props {
  title: string;
  when: string;
  place?: string;
  image?: ImageMetadata;
  link?: string;
  papers: Paper[];
  hasBody: boolean;
  sub?: boolean;
}

const { title, when, place, image, link, papers, hasBody, sub = false } = Astro.props;
const year = (d: Date) => d.getUTCFullYear();
const meta = [sub ? `Sub-project${when ? ', ' + when : ''}` : when, place]
  .filter(Boolean)
  .join(', ');
---

<article
  class:list={[
    'panel grid items-start gap-0',
    sub ? 'sm:grid-cols-[9rem_1fr]' : 'sm:grid-cols-[15rem_1fr]',
  ]}
>
  {
    image ? (
      <Image
        src={image}
        alt=""
        width={sub ? 360 : 600}
        height={sub ? 360 : 600}
        class="aspect-[16/9] w-full object-cover sm:aspect-square"
      />
    ) : (
      <div class="hidden aspect-square w-full bg-white/5 sm:block" aria-hidden="true" />
    )
  }

  <div class:list={['min-w-0', sub ? 'p-5 sm:p-6' : 'p-6 sm:p-8']}>
    {meta && <p class="text-sm tracking-wide text-accent">{meta}</p>}
    <h3 class:list={['mt-1 font-normal', sub ? 'text-lg' : 'text-xl']}>{title}</h3>

    {
      hasBody && (
        <div class="copy mt-3 text-ink/90">
          <slot />
        </div>
      )
    }

    {
      papers.length > 0 && (
        <div class="mt-5">
          <h4 class="text-sm text-muted">
            Related papers (<a href={href('/publications/')}>all publications</a>)
          </h4>
          <ul class="mt-1.5 space-y-2">
            {papers.map((paper) => (
              <li class="border-l-2 border-accent/50 pl-3 leading-snug">
                {paper.link ? <a href={paper.link}>{paper.title}</a> : paper.title}
                <span class="block text-sm text-muted">
                  {paper.status ? `${paper.status}, ` : ''}
                  {paper.venue && <em>{paper.venue}</em>}
                  {paper.venue && ' '}({year(paper.date)})
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      link && (
        <p class="mt-4 text-sm">
          <a class="action" href={link}>
            {link.includes('github.com') ? 'Code on GitHub' : 'Project page'}
          </a>
        </p>
      )
    }
  </div>
</article>
