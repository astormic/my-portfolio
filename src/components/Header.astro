---
import { site, nav } from '../site.config';
import { href } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.slice(base.length).replace(/\/?$/, '/');
---

<header class="mx-auto flex max-w-4xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-5 pt-8 pb-6 sm:px-8 sm:pt-12">
  <a href={href('/')} class="font-[650] no-underline">{site.name}</a>
  <nav aria-label="Main">
    <ul class="-mx-2 flex flex-wrap">
      {
        nav.map((item) => {
          const active = item.href === current;
          return (
            <li>
              <a
                href={href(item.href)}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block px-2 py-1 no-underline',
                  active ? 'text-accent font-[650]' : 'text-muted hover:text-accent',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
