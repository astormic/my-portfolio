---
import { site, nav } from '../site.config';
import { href } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.slice(base.length).replace(/\/?$/, '/');
---

<header class="border-b border-rule bg-paper">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-8 px-5 sm:px-8">
    <a href={href('/')} class="py-4 font-serif text-xl font-semibold no-underline">
      {site.name}
    </a>
    <nav aria-label="Main">
      <ul class="-mx-3 flex flex-wrap">
        {
          nav.map((item) => {
            const active = item.href === current;
            return (
              <li>
                <a
                  href={href(item.href)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    '-mb-px block border-b-2 px-3 py-4 text-[0.9375rem] font-medium no-underline',
                    active
                      ? 'border-accent text-ink'
                      : 'border-transparent text-muted hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
