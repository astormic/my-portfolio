---
import { site } from '../site.config';
import { href } from '../lib/url';
---

<footer class="border-t border-rule bg-surface">
  <div class="mx-auto flex max-w-5xl flex-wrap items-end justify-between gap-x-10 gap-y-4 px-5 py-10 text-sm sm:px-8">
    <div>
      <p class="font-serif text-lg font-semibold">{site.name}</p>
      <p class="text-muted">{site.role}</p>
      <p class="mt-3 text-muted">© {new Date().getFullYear()} {site.name}</p>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {
        site.links.map((link) => (
          <li>
            <a href={href(link.href)}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
