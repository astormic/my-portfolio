---
import { site } from '../site.config';
import { Image } from 'astro:assets';
import { href } from '../lib/url';
import instituteLogo from '../assets/cambridge-ceb-logo.png';
---

<footer class="border-t border-rule bg-black/55 backdrop-blur-xl">
  <div class="mx-auto flex max-w-5xl flex-wrap items-end justify-between gap-x-10 gap-y-4 px-5 py-9 text-sm sm:px-8">
    <div>
      <p class="text-lg font-normal tracking-wide">{site.name}</p>
      <p class="text-muted">{site.role}</p>
      <p class="mt-3 text-muted">© {new Date().getFullYear()} {site.name}</p>
    </div>
    <a href={site.institute.href} class="block opacity-85 hover:opacity-100">
      <Image
        src={instituteLogo}
        alt={site.institute.name}
        width={560}
        class="h-auto w-[17rem] max-w-full sm:w-[20rem]"
      />
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {
        site.links.map((link) => (
          <li>
            <a href={href(link.href)}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
