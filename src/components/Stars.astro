---
// Five stars with the filled portion clipped to the rating, so halves work.
interface Props {
  rating: number; // 0 to 5 in steps of 0.5
}
const { rating } = Astro.props;
const label = `${rating} out of 5 stars`;
---

<span class="relative inline-block whitespace-nowrap leading-none tracking-[0.08em]" role="img" aria-label={label}>
  <span class="text-rule" aria-hidden="true">★★★★★</span>
  <span
    class="absolute inset-y-0 left-0 overflow-hidden text-accent"
    style={`width:${(rating / 5) * 100}%`}
    aria-hidden="true">★★★★★</span
  >
</span>
