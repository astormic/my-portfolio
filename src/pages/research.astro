---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import background from '../assets/bg-cell-3.png';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { href, isExternal } from '../lib/url';
import { site } from '../site.config';
import { formatMonth, isoDay } from '../lib/dates';

const all = await getCollection('research');
const year = (d: Date) => d.getUTCFullYear();

// Publications: newest year first, then by `order`, then by date.
const publications = await Promise.all(
  all
    .filter((entry) => entry.data.kind === 'publication')
    .sort(
      (a, b) =>
        year(b.data.date) - year(a.data.date) ||
        a.data.order - b.data.order ||
        b.data.date.getTime() - a.data.date.getTime(),
    )
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      hasAbstract: Boolean(entry.body?.trim()),
      Abstract: (await render(entry)).Content,
    })),
);

// Projects: newest first, each with the papers that name it in `projects`.
const projects = await Promise.all(
  all
    .filter((entry) => entry.data.kind === 'project')
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      hasBody: Boolean(entry.body?.trim()),
      Body: (await render(entry)).Content,
      papers: publications.filter((paper) => paper.projects.includes(entry.id)),
    })),
);

const sharedFirst = publications.some((paper) => paper.authors?.includes('†'));
---

<Base bare background={background} heading="Research" intro="What I am working on now, and what has been published so far."
  title="Research"
  description="Research projects and publications by Amir Rahmani."
>

  {
    projects.length > 0 && (
      <section>
        <h2 class="section-title">Projects</h2>
        <ul class="space-y-4">
          {projects.map((project) => (
            <li class:list={['panel grid', project.image && 'md:grid-cols-[17rem_1fr]']}>
              {project.image && (
                <Image
                  src={project.image}
                  alt=""
                  width={640}
                  height={640}
                  class="h-56 w-full object-cover md:h-full"
                />
              )}
              <div class="min-w-0 p-6 sm:p-8">
                <p class="text-sm tracking-wide text-accent">
                  {[project.period ?? formatMonth(project.date), project.place]
                    .filter(Boolean)
                    .join(', ')}
                </p>
                <h3 class="mt-1 max-w-[60ch] text-xl font-normal">{project.title}</h3>

                {project.hasBody && (
                  <div class="copy mt-3 text-ink/90">
                    <project.Body />
                  </div>
                )}

                {project.papers.length > 0 && (
                  <div class="mt-5">
                    <h4 class="text-sm text-muted">Related papers</h4>
                    <ul class="mt-1.5 max-w-[65ch] space-y-2">
                      {project.papers.map((paper) => (
                        <li class="border-l-2 border-accent/50 pl-3 leading-snug">
                          {paper.link ? (
                            <a href={paper.link}>{paper.title}</a>
                          ) : (
                            paper.title
                          )}
                          <span class="block text-sm text-muted">
                            {paper.status ? `${paper.status}, ` : ''}
                            {paper.venue && <em>{paper.venue}</em>}
                            {paper.venue && ' '}({year(paper.date)})
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {project.link && (
                  <p class="mt-4 text-sm">
                    <a class="action" href={project.link}>
                      {project.link.includes('github.com') ? 'Code on GitHub' : 'Project page'}
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    site.instruments.length > 0 && (
      <section class="mt-12">
        <h2 class="section-title">Microscopes I have built</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {site.instruments.map((item) => (
            <li class="panel p-6">
              <h3 class="font-medium">{item.name}</h3>
              <p class="mt-1 max-w-[50ch]">{item.text}</p>
              <p class="mt-1 text-sm text-muted">{item.place}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    publications.length > 0 && (
      <section class="panel mt-12 p-6 sm:p-8">
        <h2 class="section-title">Publications</h2>
        <ul class="border-b border-rule">
          {publications.map((paper) => (
            <Entry when={String(year(paper.date))} datetime={String(year(paper.date))}>
              <h3 class="max-w-[60ch] text-lg font-medium">{paper.title}</h3>
              {(paper.authors || paper.venue || paper.status) && (
                <p class="mt-1 max-w-[65ch] text-muted">
                  {paper.authors}
                  {paper.authors && (paper.venue || paper.status) && <br />}
                  {paper.status && `${paper.status}, `}
                  {paper.venue && <em>{paper.venue}</em>}
                </p>
              )}

              {paper.hasAbstract && (
                <details class="group mt-3">
                  <summary class="w-fit cursor-pointer text-sm text-muted hover:text-accent">
                    <span class="group-open:hidden">Show abstract</span>
                    <span class="hidden group-open:inline">Hide abstract</span>
                  </summary>
                  <div class="copy mt-3">
                    <paper.Abstract />
                  </div>
                </details>
              )}

              {(paper.pdf || paper.link) && (
                <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                  {paper.pdf && (
                    <a
                      class="action"
                      href={href(paper.pdf)}
                      download={!isExternal(paper.pdf)}
                    >
                      Download PDF
                    </a>
                  )}
                  {paper.link && (
                    <a class="action" href={paper.link}>
                      Read the paper
                    </a>
                  )}
                </p>
              )}
            </Entry>
          ))}
        </ul>
        {sharedFirst && (
          <p class="mt-4 text-sm text-muted">† These authors contributed equally.</p>
        )}
      </section>
    )
  }

  {
    all.length === 0 && (
      <p class="text-muted">
        Nothing here yet. Add a Markdown file to src/content/research/.
      </p>
    )
  }
</Base>
