---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Entry from '../components/Entry.astro';
import { href, isExternal } from '../lib/url';
import { formatMonth, isoDay } from '../lib/dates';

const all = (await getCollection('research')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const prepare = (kind: 'project' | 'publication') =>
  Promise.all(
    all
      .filter((entry) => entry.data.kind === kind)
      .map(async (entry) => ({
        ...entry.data,
        id: entry.id,
        hasAbstract: Boolean(entry.body?.trim()),
        Abstract: (await render(entry)).Content,
      })),
  );

const sections = [
  { heading: 'Projects', items: await prepare('project') },
  { heading: 'Publications', items: await prepare('publication') },
];
---

<Base
  title="Research"
  description="Research projects and publications, with abstracts and PDFs."
>
  <PageTitle
    title="Research"
    intro="What I am working on now, and what has been published so far."
  />

  {
    sections.map(
      (section) =>
        section.items.length > 0 && (
          <section class="mt-16 first-of-type:mt-0 sm:mt-20">
            <h2 class="mb-4 text-xl font-[650]">{section.heading}</h2>
            <ul class="border-b border-rule">
              {section.items.map((item) => (
                <Entry when={formatMonth(item.date)} datetime={isoDay(item.date)}>
                  <h3 class="max-w-[60ch] text-lg font-[650]">{item.title}</h3>
                  {(item.authors || item.venue) && (
                    <p class="mt-1 max-w-[65ch] text-muted">
                      {item.authors}
                      {item.authors && item.venue && <br />}
                      {item.venue && <em>{item.venue}</em>}
                    </p>
                  )}

                  {item.hasAbstract && (
                    <details class="group mt-3">
                      <summary class="w-fit cursor-pointer text-sm text-muted hover:text-accent">
                        <span class="group-open:hidden">Show abstract</span>
                        <span class="hidden group-open:inline">Hide abstract</span>
                      </summary>
                      <div class="copy mt-3">
                        <item.Abstract />
                      </div>
                    </details>
                  )}

                  {(item.pdf || item.link) && (
                    <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                      {item.pdf && (
                        <a
                          class="action"
                          href={href(item.pdf)}
                          download={!isExternal(item.pdf)}
                        >
                          Download PDF
                        </a>
                      )}
                      {item.link && (
                        <a class="action" href={item.link}>
                          {section.heading === 'Projects'
                            ? 'Project page'
                            : 'Publisher page'}
                        </a>
                      )}
                    </p>
                  )}
                </Entry>
              ))}
            </ul>
          </section>
        ),
    )
  }

  {
    all.length === 0 && (
      <p class="text-muted">
        Nothing here yet. Add a Markdown file to src/content/research/.
      </p>
    )
  }
</Base>
