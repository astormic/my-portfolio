---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import background from '../assets/bg-cell-3.png';
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import { site } from '../site.config';
import { formatMonth, isoDay } from '../lib/dates';

const all = await getCollection('research');
const year = (d: Date) => d.getUTCFullYear();

// Publications, so each project can list its related papers.
const publications = await Promise.all(
  all
    .filter((entry) => entry.data.kind === 'publication')
    .sort(
      (a, b) =>
        year(b.data.date) - year(a.data.date) ||
        a.data.order - b.data.order ||
        b.data.date.getTime() - a.data.date.getTime(),
    )
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      hasAbstract: Boolean(entry.body?.trim()),
      Abstract: (await render(entry)).Content,
    })),
);

// Projects: newest first, each with the papers that name it in `projects`.
const projects = await Promise.all(
  all
    .filter((entry) => entry.data.kind === 'project')
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      hasBody: Boolean(entry.body?.trim()),
      Body: (await render(entry)).Content,
      papers: publications.filter((paper) => paper.projects.includes(entry.id)),
    })),
);

---

<Base bare background={background} heading="Research" intro="What I am working on now, and the microscopes I have built along the way."
  title="Research"
  description="Research projects and custom-built microscopes by Amir Rahmani."
>

  {
    projects.length > 0 && (
      <section>
        <h2 class="section-title">Projects</h2>
        <ul class="space-y-4">
          {projects.map((project) => (
            <li class:list={['panel grid', project.image && 'md:grid-cols-[17rem_1fr]']}>
              {project.image && (
                <Image
                  src={project.image}
                  alt=""
                  width={640}
                  height={640}
                  class="h-56 w-full object-cover md:h-full"
                />
              )}
              <div class="min-w-0 p-6 sm:p-8">
                <p class="text-sm tracking-wide text-accent">
                  {[project.period ?? formatMonth(project.date), project.place]
                    .filter(Boolean)
                    .join(', ')}
                </p>
                <h3 class="mt-1 max-w-[60ch] text-xl font-normal">{project.title}</h3>

                {project.hasBody && (
                  <div class="copy mt-3 text-ink/90">
                    <project.Body />
                  </div>
                )}

                {project.papers.length > 0 && (
                  <div class="mt-5">
                    <h4 class="text-sm text-muted">
                      Related papers (<a href={href('/publications/')}>all publications</a>)
                    </h4>
                    <ul class="mt-1.5 max-w-[65ch] space-y-2">
                      {project.papers.map((paper) => (
                        <li class="border-l-2 border-accent/50 pl-3 leading-snug">
                          {paper.link ? (
                            <a href={paper.link}>{paper.title}</a>
                          ) : (
                            paper.title
                          )}
                          <span class="block text-sm text-muted">
                            {paper.status ? `${paper.status}, ` : ''}
                            {paper.venue && <em>{paper.venue}</em>}
                            {paper.venue && ' '}({year(paper.date)})
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {project.link && (
                  <p class="mt-4 text-sm">
                    <a class="action" href={project.link}>
                      {project.link.includes('github.com') ? 'Code on GitHub' : 'Project page'}
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    site.instruments.length > 0 && (
      <section class="mt-12">
        <h2 class="section-title">Microscopes I have built</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {site.instruments.map((item) => (
            <li class="panel p-6">
              <h3 class="font-medium">{item.name}</h3>
              <p class="mt-1 max-w-[50ch]">{item.text}</p>
              <p class="mt-1 text-sm text-muted">{item.place}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    all.length === 0 && (
      <p class="text-muted">
        Nothing here yet. Add a Markdown file to src/content/research/.
      </p>
    )
  }
</Base>
