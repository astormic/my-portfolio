---
import { getCollection, render } from 'astro:content';
import background from '../assets/bg-cell-3.png';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site.config';
import { formatMonth, isoDay } from '../lib/dates';

const all = await getCollection('research');
const year = (d: Date) => d.getUTCFullYear();

// Publications, so each project can list its related papers.
const publications = await Promise.all(
  all
    .filter((entry) => entry.data.kind === 'publication')
    .sort(
      (a, b) =>
        year(b.data.date) - year(a.data.date) ||
        a.data.order - b.data.order ||
        b.data.date.getTime() - a.data.date.getTime(),
    )
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      hasAbstract: Boolean(entry.body?.trim()),
      Abstract: (await render(entry)).Content,
    })),
);

// Projects: newest first, each with the papers that name it in `projects`.
const allProjects = await Promise.all(
  all
    .filter((entry) => entry.data.kind === 'project')
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      when: entry.data.period ?? formatMonth(entry.data.date),
      hasBody: Boolean(entry.body?.trim()),
      Body: (await render(entry)).Content,
      papers: publications.filter((paper) => paper.projects.includes(entry.id)),
    })),
);

// Main projects, each carrying its sub-projects (those whose `parent` names it).
const ids = new Set(allProjects.map((project) => project.id));
const projects = allProjects
  .filter((project) => !project.parent || !ids.has(project.parent))
  .map((project) => ({
    ...project,
    children: allProjects.filter((child) => child.parent === project.id),
  }));

---

<Base bare background={background} heading="Research" intro="What I am working on now, and the microscopes I have built along the way."
  title="Research"
  description="Research projects and custom-built microscopes by Amir Rahmani."
>

  {
    projects.length > 0 && (
      <section>
        <h2 class="section-title">Projects</h2>
        <ul class="space-y-6">
          {projects.map((project) => (
            <li>
              <ProjectCard
                title={project.title}
                when={project.when}
                place={project.place}
                image={project.image}
                link={project.link}
                papers={project.papers}
                hasBody={project.hasBody}
              >
                <project.Body />
              </ProjectCard>

              {project.children.length > 0 && (
                <ul class="mt-3 ml-6 space-y-3 border-l-2 border-accent/60 pl-4 sm:ml-[7.5rem] sm:pl-6">
                  {project.children.map((child) => (
                    <li>
                      <ProjectCard
                        sub
                        title={child.title}
                        when={child.when}
                        place={child.place}
                        image={child.image}
                        link={child.link}
                        papers={child.papers}
                        hasBody={child.hasBody}
                      >
                        <child.Body />
                      </ProjectCard>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    site.instruments.length > 0 && (
      <section class="mt-12">
        <h2 class="section-title">Microscopes I have built</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {site.instruments.map((item) => (
            <li class="panel p-6">
              <h3 class="font-medium">{item.name}</h3>
              <p class="mt-1 max-w-[50ch]">{item.text}</p>
              <p class="mt-1 text-sm text-muted">{item.place}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    all.length === 0 && (
      <p class="text-muted">
        Nothing here yet. Add a Markdown file to src/content/research/.
      </p>
    )
  }
</Base>
