---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href, isExternal } from '../lib/url';
import { site } from '../site.config';
import background from '../assets/particle-tracking.png';

// Publications live in src/content/research/ with `kind: publication`.
const year = (d: Date) => d.getUTCFullYear();

// Newest year first, then by `order`, then by date.
const publications = await Promise.all(
  (await getCollection('research'))
    .filter((entry) => entry.data.kind === 'publication')
    .sort(
      (a, b) =>
        year(b.data.date) - year(a.data.date) ||
        a.data.order - b.data.order ||
        b.data.date.getTime() - a.data.date.getTime(),
    )
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      year: year(entry.data.date),
      // A link of the form https://doi.org/10.xxxx is shown as "doi: 10.xxxx".
      doi: entry.data.link?.match(/doi\.org\/(.+)$/)?.[1],
      hasAbstract: Boolean(entry.body?.trim()),
      Abstract: (await render(entry)).Content,
    })),
);

// One group per year, newest first.
const years = [...new Set(publications.map((paper) => paper.year))].map((y) => ({
  year: y,
  papers: publications.filter((paper) => paper.year === y),
}));

// Your name as it appears in author lists, shown brighter so it stands out.
const me = 'Rahmani, A.';

const sharedFirst = publications.some((paper) => paper.authors?.includes('†'));
const profiles = site.links.filter((link) =>
  ['Google Scholar', 'ORCID'].includes(link.label),
);
---

<Base
  bare
  background={background}
  heading="Publications"
  intro="Papers, preprints and book chapters, newest first."
  title="Publications"
  description="Publications by Amir Rahmani: papers, preprints and book chapters."
>
  {
    profiles.length > 0 && (
      <ul slot="lead" class="mt-7 flex flex-wrap gap-2.5">
        {profiles.map((link) => (
          <li>
            <a class="button" href={href(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    publications.length > 0 ? (
      <section class="panel p-6 sm:p-10">
        <div class="space-y-10">
          {years.map((group) => (
            <section aria-labelledby={`year-${group.year}`}>
              <h2 id={`year-${group.year}`} class="section-title !mb-4 tabular-nums">
                {group.year}
              </h2>
              <ol class="space-y-7 border-l-2 border-accent/60 pl-5 sm:pl-7">
                {group.papers.map((paper) => (
                  <li>
                    <h3 class="text-lg leading-snug font-medium">{paper.title}</h3>

                    {paper.authors && (
                      <p class="mt-1 text-muted">
                        {paper.authors.split(me).map((part, i) => (
                          <>
                            {i > 0 && <span class="font-medium text-ink">{me}</span>}
                            {part}
                          </>
                        ))}
                      </p>
                    )}

                    <p class="mt-0.5 text-muted">
                      {paper.status && `${paper.status}, `}
                      {paper.venue && <em>{paper.venue}</em>} ({paper.year})
                      {paper.doi ? (
                        <>
                          . doi:{' '}
                          <a href={paper.link} class="break-all">
                            {paper.doi}
                          </a>
                        </>
                      ) : (
                        paper.link && (
                          <>
                            . <a href={paper.link}>Link</a>
                          </>
                        )
                      )}
                    </p>

                    {(paper.hasAbstract || paper.pdf) && (
                      <div class="mt-2 flex flex-wrap items-start gap-x-5 gap-y-1 text-sm">
                        {paper.pdf && (
                          <a
                            class="action"
                            href={href(paper.pdf)}
                            download={!isExternal(paper.pdf)}
                          >
                            Download PDF
                          </a>
                        )}
                        {paper.hasAbstract && (
                          <details class="group basis-full">
                            <summary class="w-fit cursor-pointer text-muted hover:text-accent">
                              <span class="group-open:hidden">Show abstract</span>
                              <span class="hidden group-open:inline">Hide abstract</span>
                            </summary>
                            <div class="copy mt-3 text-base">
                              <paper.Abstract />
                            </div>
                          </details>
                        )}
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>

        {sharedFirst && (
          <p class="mt-10 border-t border-rule pt-4 text-sm text-muted">
            † These authors contributed equally.
          </p>
        )}
      </section>
    ) : (
      <p class="text-muted">
        Nothing here yet. Add a Markdown file with kind: publication to src/content/research/.
      </p>
    )
  }
</Base>

<style>
  /* Titles wrap naturally across the full width rather than being balanced. */
  h3 {
    text-wrap: pretty;
  }
</style>
