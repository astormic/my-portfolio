---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stars from '../components/Stars.astro';

// Most recently read first; books without a date go last, by title.
const all = (await getCollection('books')).sort((a, b) => {
  const diff = (b.data.read?.getTime() ?? 0) - (a.data.read?.getTime() ?? 0);
  return diff || a.data.title.localeCompare(b.data.title);
});

const groups = [
  { heading: 'Currently reading', books: all.filter((book) => book.data.reading) },
  { heading: 'Read', books: all.filter((book) => !book.data.reading) },
].filter((group) => group.books.length > 0);

// Only label the groups when there is more than one.
const labelled = groups.length > 1;
---

<Base heading="Books" intro="What I have been reading, and what I made of it." title="Books" description="Books I have read, with my ratings.">

  {
    groups.length > 0 ? (
      groups.map((group, index) => (
        <section class:list={[index > 0 && 'mt-14']}>
          {labelled && <h2 class="section-title">{group.heading}</h2>}
          <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 md:grid-cols-4">
            {group.books.map(({ data }) => (
              <li>
                {data.cover ? (
                  <Image
                    src={data.cover}
                    alt={`${data.title} by ${data.author}`}
                    width={360}
                    height={540}
                    loading="lazy"
                    class="aspect-[2/3] w-full border border-rule object-cover"
                  />
                ) : (
                  <div class="panel flex aspect-[2/3] w-full flex-col justify-between p-5">
                    <span class="text-xl leading-snug font-light">{data.title}</span>
                    <span class="text-sm text-muted">{data.author}</span>
                  </div>
                )}
                <h3 class="mt-3 leading-snug font-medium">
                  {data.link ? <a href={data.link}>{data.title}</a> : data.title}
                </h3>
                <p class="text-sm text-muted">{data.author}</p>
                {data.rating !== undefined && (
                  <p class="mt-1.5">
                    <Stars rating={data.rating} />
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p class="text-muted">
        Nothing here yet. Add a YAML file to src/content/books/.
      </p>
    )
  }
</Base>
