---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { site } from '../site.config';
import { href } from '../lib/url';
import { formatMonth } from '../lib/dates';

const year = (d: Date) => d.getUTCFullYear();

// Positions held now, shown beside the bio.
const current = site.experience.filter((row) => row.years.endsWith('to now'));

// The three newest publications and news cards, as a preview.
const publications = (await getCollection('research'))
  .filter((entry) => entry.data.kind === 'publication')
  .sort(
    (a, b) =>
      year(b.data.date) - year(a.data.date) ||
      a.data.order - b.data.order ||
      b.data.date.getTime() - a.data.date.getTime(),
  )
  .slice(0, 3);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const sections = [
  { heading: 'Experience', rows: site.experience },
  { heading: 'Education', rows: site.education },
  { heading: 'Teaching', rows: site.teaching },
  { heading: 'Student supervision', rows: site.supervision },
  { heading: 'Honours and awards', rows: site.awards },
];
---

<Base heading={site.name} intro={site.role}>
  <div slot="lead" class="mt-8 grid gap-x-12 gap-y-8 lg:grid-cols-[1fr_19rem]">
    <div>
      <div class="copy text-lg">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="mt-7 flex flex-wrap gap-2.5">
        {
          site.cv && (
            <li>
              <a class="button button-primary" href={href(site.cv)} download>
                Download CV
              </a>
            </li>
          )
        }
        {
          site.links.map((link) => (
            <li>
              <a class="button" href={href(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      current.length > 0 && (
        <aside class="self-start rounded-md border border-rule bg-paper p-5">
          <h2 class="text-sm font-semibold text-muted">Currently</h2>
          <ul class="mt-3 space-y-3">
            {current.map((row) => (
              <li class="leading-snug">
                <span class="block font-medium">{row.title}</span>
                <span class="block text-sm text-muted">{row.place}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <div class="grid gap-x-12 gap-y-14 lg:grid-cols-2">
    {
      publications.length > 0 && (
        <section>
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="section-title">Recent publications</h2>
            <a class="action text-sm whitespace-nowrap" href={href('/research/')}>
              All research
            </a>
          </div>
          <ul class="border-b border-rule">
            {publications.map(({ data }) => (
              <li class="border-t border-rule py-4 leading-snug">
                {data.link ? (
                  <a class="font-medium" href={data.link}>
                    {data.title}
                  </a>
                ) : (
                  <span class="font-medium">{data.title}</span>
                )}
                <span class="mt-1 block text-sm text-muted">
                  {data.status ? `${data.status}, ` : ''}
                  {data.venue && <em>{data.venue}</em>} ({year(data.date)})
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      news.length > 0 && (
        <section>
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="section-title">Latest news</h2>
            <a class="action text-sm whitespace-nowrap" href={href('/news/')}>
              All news
            </a>
          </div>
          <ul class="border-b border-rule">
            {news.map(({ data }) => (
              <li class="border-t border-rule py-4 leading-snug">
                <span class="font-medium">{data.title}</span>
                <span class="mt-1 block text-sm text-muted">
                  {data.kind}, {data.when ?? formatMonth(data.date)}
                  {data.place && `, ${data.place}`}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  {
    sections.map(
      (section) =>
        section.rows.length > 0 && (
          <section class="mt-16 sm:mt-20">
            <h2 class="section-title">{section.heading}</h2>
            <ul class="border-b border-rule">
              {section.rows.map((row) => (
                <Entry when={row.years}>
                  <h3 class="font-semibold">{row.title}</h3>
                  <p class="text-muted">{row.place}</p>
                  {row.note && <p class="mt-1 max-w-[60ch]">{row.note}</p>}
                </Entry>
              ))}
            </ul>
          </section>
        ),
    )
  }

  {
    site.skills.length > 0 && (
      <section class="mt-16 sm:mt-20">
        <h2 class="section-title">Skills</h2>
        <ul class="flex flex-wrap gap-2">
          {site.skills.map((skill) => (
            <li class="rounded-md border border-rule bg-surface px-3 py-1.5 text-[0.9375rem]">
              {skill}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
