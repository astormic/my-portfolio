---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { site } from '../site.config';
import { href } from '../lib/url';
import background from '../assets/bg-cell-1.png';
import cellImage from '../assets/bg-cell-2.png';
import trackingImage from '../assets/particle-tracking.png';
import tableImage from '../assets/optical-table.jpg';
import logo from '../assets/logo.png';

// Positions held now, shown beside the bio: current jobs from Experience,
// plus any Service and leadership entry marked `currently: true`.
const current = [
  ...site.experience.filter((row) => row.years.endsWith('Present')),
  ...site.service.filter((row) => 'currently' in row && row.currently),
];

// The three picture tiles under the bio. Each links to the Research page.
// To change a picture, put the file in src/assets/ and import it above.
const focus = [
  { title: 'Sub-zero live-cell super-resolution imaging', image: cellImage },
  { title: 'Single-molecule imaging and tracking', image: trackingImage },
  { title: 'Optical system development', image: tableImage },
];

const sections = [
  { heading: 'Experience', rows: site.experience },
  { heading: 'Education', rows: site.education },
  { heading: 'Teaching', rows: site.teaching },
  { heading: 'Student supervision', rows: site.supervision },
  { heading: 'Service and leadership', rows: site.service },
  { heading: 'Honours and awards', rows: site.awards },
];
---

<Base heading={site.name} intro={site.role} background={background} bare>
  <div slot="lead" class="mt-9 grid gap-x-10 gap-y-8 lg:grid-cols-[1fr_19rem]">
    <div>
      <div class="copy text-lg text-ink/95">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="mt-7 flex flex-wrap gap-2.5">
        {
          site.cv && (
            <li>
              <a class="button button-primary" href={href(site.cv)} download>
                Download CV
              </a>
            </li>
          )
        }
        {
          site.links.map((link) => (
            <li>
              <a class="button" href={href(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      current.length > 0 && (
        <aside class="panel self-start p-5">
          <h2 class="text-sm tracking-[0.14em] text-accent uppercase">Currently</h2>
          <ul class="mt-3 space-y-3">
            {current.map((row) => (
              <li class="leading-snug">
                <span class="block font-normal">{row.title}</span>
                <span class="block text-sm text-muted">{row.place}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <ul class="grid gap-4 sm:grid-cols-3">
    {
      focus.map((item) => (
        <li>
          <a
            href={href('/research/')}
            class="group relative block overflow-hidden border border-rule no-underline"
          >
            <Image
              src={item.image}
              alt=""
              width={640}
              height={480}
              class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
            />
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent px-4 pt-12 pb-4 text-lg leading-snug font-normal text-ink">
              {item.title}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    sections.map(
      (section) =>
        section.rows.length > 0 && (
          <section class="panel mt-6 p-6 sm:p-8">
            <h2 class="section-title">{section.heading}</h2>
            <ul class="border-b border-rule">
              {section.rows.map((row) => (
                <Entry when={row.years}>
                  <h3 class="font-medium">{row.title}</h3>
                  <p class="text-muted">{row.place}</p>
                  {row.note && <p class="mt-0.5 text-[0.95rem] text-muted">{row.note}</p>}
                </Entry>
              ))}
            </ul>
          </section>
        ),
    )
  }

  {
    site.skills.length > 0 && (
      <section class="panel mt-6 p-6 sm:p-8">
        <h2 class="section-title">Expertise</h2>
        <ul class="flex flex-wrap gap-2">
          {site.skills.map((skill) => (
            <li class="border border-rule bg-white/5 px-3 py-1.5 text-[0.95rem]">{skill}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    site.brandMeaning.length > 0 && (
      <section class="panel mt-6 grid items-center gap-6 p-6 sm:grid-cols-[9rem_1fr] sm:p-8">
        <Image src={logo} alt={`The ${site.brand} logo`} width={256} height={256} class="size-28 rounded-full ring-1 ring-white/25 sm:size-36" />
        <div>
          <h2 class="section-title">About {site.brand}</h2>
          <div class="copy text-ink/90">
            {site.brandMeaning.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>
    )
  }
</Base>
