---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Entry from '../components/Entry.astro';
import { site } from '../site.config';
import { href } from '../lib/url';

const sections = [
  { heading: 'Education', rows: site.education },
  { heading: 'Experience', rows: site.experience },
];
---

<Base>
  <PageTitle title={site.name} intro={site.role} />

  <div class="copy text-lg">
    {site.bio.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
    {
      site.cv && (
        <li>
          <a class="action" href={href(site.cv)} download>
            Download CV (PDF)
          </a>
        </li>
      )
    }
    {
      site.links.map((link) => (
        <li>
          <a href={href(link.href)}>{link.label}</a>
        </li>
      ))
    }
  </ul>

  {
    sections.map(
      (section) =>
        section.rows.length > 0 && (
          <section class="mt-16 sm:mt-20">
            <h2 class="mb-4 text-xl font-[650]">{section.heading}</h2>
            <ul class="border-b border-rule">
              {section.rows.map((row) => (
                <Entry when={row.years}>
                  <h3 class="font-[650]">{row.title}</h3>
                  <p class="text-muted">{row.place}</p>
                  {row.note && <p class="mt-1 max-w-[60ch]">{row.note}</p>}
                </Entry>
              ))}
            </ul>
          </section>
        ),
    )
  }

  {
    site.skills.length > 0 && (
      <section class="mt-16 sm:mt-20">
        <h2 class="mb-4 text-xl font-[650]">Skills</h2>
        <ul class="border-b border-rule">
          {site.skills.map((skill) => (
            <li class="border-t border-rule py-3">{skill}</li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
