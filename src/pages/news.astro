---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { formatMonth, isoDay } from '../lib/dates';
import background from '../assets/bg-nuclei.jpg';

const cards = await Promise.all(
  (await getCollection('news'))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry) => ({
      ...entry.data,
      id: entry.id,
      hasBody: Boolean(entry.body?.trim()),
      Body: (await render(entry)).Content,
    })),
);

// Filter buttons, shown only for categories that have at least one card.
const filters = [
  { id: 'research', label: 'Research' },
  { id: 'conference', label: 'Conferences and talks' },
  { id: 'public', label: 'Public engagement' },
  { id: 'award', label: 'Awards' },
  { id: 'note', label: 'Notes' },
].filter((filter) => cards.some((card) => card.category === filter.id));

const embedUrl = (urn: string) =>
  `https://www.linkedin.com/embed/feed/update/urn:li:${urn.replace(/^urn:li:/, '')}`;
---

<Base
  bare
  background={background}
  heading="News"
  intro="Research, conferences, public engagement and the occasional note."
  title="News"
  description="Research news, conferences, public engagement and notes from Amir Rahmani."
>
  {
    cards.length > 0 ? (
      <div class="mx-auto max-w-2xl">
        {filters.length > 1 && (
          <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Show">
            <button class="filter" data-filter="all" aria-pressed="true">
              All
            </button>
            {filters.map((filter) => (
              <button class="filter" data-filter={filter.id} aria-pressed="false">
                {filter.label}
              </button>
            ))}
          </div>
        )}

        <ol id="cards" class="space-y-8">
          {cards.map((card) => (
            <li data-category={card.category} class="panel overflow-hidden">
              {card.image && (
                <Image
                  src={card.image}
                  alt=""
                  width={1344}
                  loading="lazy"
                  class="max-h-[40rem] w-full object-cover object-top"
                />
              )}

              <div class="p-6 sm:p-8">
                <p class="text-sm text-muted tabular-nums">
                  {card.when ?? (
                    <time datetime={isoDay(card.date)}>{formatMonth(card.date)}</time>
                  )}
                  {card.place && ` - ${card.place}`}
                </p>
                <h2 class="mt-2 text-2xl leading-snug font-normal">{card.title}</h2>
                <p class="mt-1 text-sm tracking-wide text-accent">{card.kind}</p>

                {card.hasBody && (
                  <div class="copy mt-4 text-ink/90">
                    <card.Body />
                  </div>
                )}

                {card.link && (
                  <p class="mt-4 text-sm">
                    <a class="action" href={card.link}>
                      {card.category === 'research' && card.link.includes('doi.org')
                        ? 'Read the paper'
                        : 'See more'}
                    </a>
                  </p>
                )}

                {card.linkedin &&
                  (card.image ? (
                    <details class="linkedin mt-6 border-t border-rule pt-4">
                      <summary class="w-fit cursor-pointer text-sm text-muted hover:text-accent">
                        <span class="closed">Show the LinkedIn post</span>
                        <span class="opened">Hide the LinkedIn post</span>
                      </summary>
                      <div class="embed mt-4">
                        <iframe
                          src={embedUrl(card.linkedin)}
                          height={card.linkedinHeight}
                          title={`LinkedIn post: ${card.title}`}
                          loading="lazy"
                          allowfullscreen
                        />
                      </div>
                    </details>
                  ) : (
                    <div class="embed mt-6">
                      <iframe
                        src={embedUrl(card.linkedin)}
                        height={card.linkedinHeight}
                        title={`LinkedIn post: ${card.title}`}
                        loading="lazy"
                        allowfullscreen
                      />
                    </div>
                  ))}
              </div>
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <p class="text-muted">
        Nothing here yet. Add a Markdown file to src/content/news/.
      </p>
    )
  }
</Base>

<style>
  .filter {
    cursor: pointer;
    border: 1px solid var(--color-rule);
    padding: 0.3rem 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: rgb(0 0 0 / 0.35);
  }
  .filter:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .filter[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #04110f;
  }

  /* LinkedIn's embed is a white card; give it a matching white frame. */
  .embed {
    margin-inline: auto;
    max-width: 504px;
    overflow: hidden;
    border-radius: 8px;
    background: #fff;
  }
  .embed iframe {
    display: block;
    width: 100%;
    border: 0;
  }

  .linkedin .opened,
  .linkedin[open] .closed {
    display: none;
  }
  .linkedin[open] .opened {
    display: inline;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('#cards > li');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const chosen = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        card.hidden = chosen !== 'all' && card.dataset.category !== chosen;
      });
    });
  });
</script>
