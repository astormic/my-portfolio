---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { href } from '../lib/url';

interface Props {
  // Browser tab title. Left out on the home page.
  title?: string;
  description?: string;
  // The large heading in the band at the top of the page, and the line under it.
  heading: string;
  intro?: string;
}

const { title, description = site.description, heading, intro } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10 focus:bg-paper focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header />

    <div class="border-b border-rule bg-surface">
      <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
        <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">
          {heading}
        </h1>
        {intro && <p class="mt-3 max-w-[60ch] text-lg text-muted sm:text-xl">{intro}</p>}
        <slot name="lead" />
      </div>
    </div>

    <main id="main" class="mx-auto w-full max-w-5xl grow px-5 py-12 sm:px-8 sm:py-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
